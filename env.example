import { createClient } from '@/lib/supabase/server'
import { notFound } from 'next/navigation'
import QrCode from '@/components/QrCode'

function buildWhatsAppLink(phone: string | null | undefined, url: string, numero: string) {
  const text = encodeURIComponent(
    `Hola, te comparto el enlace para firmar la recepción del albarán ${numero}:\n${url}`
  )
  if (phone) {
    const clean = phone.replace(/[^0-9+]/g, '')
    return `https://wa.me/${clean}?text=${text}`
  }
  return `https://wa.me/?text=${text}`
}

export default async function AlbaranDetailPage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = await params
  const supabase = await createClient()

  const { data: albaran } = await supabase
    .from('albaranes')
    .select('*, albaran_items(*), clients(phone)')
    .eq('id', id)
    .single()

  if (!albaran) notFound()

  const siteUrl = process.env.NEXT_PUBLIC_SITE_URL || ''
  const signPath = `/albaranes/${id}/firmar`
  const signUrl = siteUrl ? `${siteUrl}${signPath}` : signPath
  const clientPhone = albaran.clients?.phone as string | undefined
  const whatsappLink = buildWhatsAppLink(clientPhone, signUrl, albaran.numero)

  return (
    <div className="max-w-xl mx-auto py-10 px-4">
      <h1 className="text-2xl font-semibold text-[#1C1F26] mb-1">Albarán {albaran.numero}</h1>
      <p className="text-neutral-500 mb-6">{albaran.client_name_snapshot} · {albaran.fecha}</p>

      <span className={`inline-block text-xs px-2 py-1 rounded-full mb-6 ${
        albaran.estado === 'firmado' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700'
      }`}>
        {albaran.estado}
      </span>

      {albaran.estado === 'pendiente' && (
        <div className="border rounded-lg p-4 mb-6 bg-neutral-50">
          <p className="text-sm text-neutral-600 mb-4">
            Comparte este enlace con el cliente o encargado para que firme la recepción.
            Funciona sin necesidad de cuenta: puede escanear el QR con el móvil o recibirlo por WhatsApp.
          </p>

          <div className="flex items-start gap-4 mb-4">
            <QrCode value={signUrl} size={140} />
            <div className="flex-1">
              <code className="block bg-white border rounded px-3 py-2 text-xs break-all mb-3">
                {signUrl}
              </code>
              <a
                href={whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                className="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[#25D366] text-white text-sm font-medium"
              >
                Enviar por WhatsApp
              </a>
            </div>
          </div>

          {!siteUrl && (
            <p className="text-xs text-amber-600">
              Define NEXT_PUBLIC_SITE_URL en tus variables de entorno para que el enlace
              y el QR funcionen fuera de tu red local (por ejemplo, tu dominio de Vercel).
            </p>
          )}
        </div>
      )}

      <a
        href={`/api/albaranes/${id}/pdf`}
        target="_blank"
        className="inline-block px-4 py-2 rounded-md bg-[#164394] text-white text-sm"
      >
        Ver / descargar PDF
      </a>
    </div>
  )
}
